<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".arcore.ArCoreFaceAnchorActivity">

    <android.opengl.GLSurfaceView
        android:id="@+id/arcore_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/permission_panel"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/glass_900"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/permission_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/camera_permission_title"
            android:textColor="@color/text_primary_on_dark"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/permission_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/camera_permission_message"
            android:textColor="@color/text_secondary_on_dark"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/permission_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/camera_permission_action"
            android:textAllCaps="false"
            android:textColor="@color/ink_950"
            app:backgroundTint="@color/rose_300"
            app:cornerRadius="14dp" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/phase_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="@color/glass_900"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/glass_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tuning_title"
                    android:textColor="@color/text_primary_on_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/copy_tuning"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minWidth="0dp"
                    android:text="@string/tuning_copy"
                    android:textAllCaps="false"
                    android:textColor="@color/rose_300" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/reset_tuning"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minWidth="0dp"
                    android:text="@string/tuning_reset"
                    android:textAllCaps="false"
                    android:textColor="@color/rose_300" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/toggle_tuning"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minWidth="0dp"
                    android:text="@string/tuning_collapse"
                    android:textAllCaps="false"
                    android:textColor="@color/rose_300" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/tuning_scroll"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:clipToPadding="false"
                android:fadeScrollbars="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:id="@+id/tuning_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/LipTuningSection"
                        android:text="@string/finish_group" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/finish_toggle_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        app:checkedButton="@id/finish_satin"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/finish_matte"
                            style="@style/LipTuningToggle"
                            android:text="@string/finish_matte" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/finish_satin"
                            style="@style/LipTuningToggle"
                            android:text="@string/finish_satin" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/finish_gloss"
                            style="@style/LipTuningToggle"
                            android:text="@string/finish_gloss" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/finish_tracking_test"
                            style="@style/LipTuningToggle"
                            android:text="@string/finish_tracking_test" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <TextView
                        style="@style/LipTuningSection"
                        android:text="@string/timeline_label" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/timeline_toggle_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        app:checkedButton="@id/timeline_same_frame"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/timeline_async"
                            style="@style/LipTuningToggle"
                            android:text="@string/timeline_async" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/timeline_same_frame"
                            style="@style/LipTuningToggle"
                            android:text="@string/timeline_same_frame" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>