#version 450

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 6) readonly buffer FlowVectors {
    vec4 vectors[];
} inputFlow;
layout(std430, set = 0, binding = 7) buffer FitResult {
    vec4 values[4];
} outputFit;

layout(push_constant) uniform TemporalState {
    mat4 uvTransform;
    vec4 roi;
    ivec4 parameters;
} state;

const ivec2 GRID_SIZE = ivec2(12, 9);
const int POINT_COUNT = GRID_SIZE.x * GRID_SIZE.y;

vec2 pointAt(int index) {
    ivec2 grid = ivec2(index % GRID_SIZE.x, index / GRID_SIZE.x);
    vec2 gridUv = (vec2(grid) + vec2(0.5)) / vec2(GRID_SIZE);
    return mix(state.roi.xy, state.roi.zw, gridUv);
}

float baseWeight(vec4 flow) {
    if (flow.z < 0.14 || flow.w > 0.14) {
        return 0.0;
    }
    return flow.z * clamp(1.0 - flow.w / 0.14, 0.0, 1.0);
}

float cornerSpatialWeight(int index, bool rightCorner) {
    vec2 roiExtent = max(state.roi.zw - state.roi.xy, vec2(1e-5));
    vec2 normalizedPoint = (pointAt(index) - state.roi.xy) / roiExtent;
    vec2 center = vec2(rightCorner ? 0.8333 : 0.1667, 0.5);
    vec2 normalizedDistance = (normalizedPoint - center) / vec2(0.16, 0.24);
    return exp(-0.5 * dot(normalizedDistance, normalizedDistance));
}

vec4 fitCornerTranslation(bool rightCorner) {
    vec2 initial = vec2(0.0);
    float initialWeight = 0.0;
    for (int index = 0; index < POINT_COUNT; ++index) {
        vec4 flow = inputFlow.vectors[index];
        float weight = baseWeight(flow) * cornerSpatialWeight(index, rightCorner);
        initial += flow.xy * weight;
        initialWeight += weight;
    }
    if (initialWeight < 1.5) {
        return vec4(0.0);
    }
    initial /= initialWeight;

    vec2 fitted = vec2(0.0);
    float fittedWeight = 0.0;
    for (int index = 0; index < POINT_COUNT; ++index) {
        vec4 flow = inputFlow.vectors[index];
        float spatialWeight = cornerSpatialWeight(index, rightCorner);
        float weight = baseWeight(flow) * spatialWeight;
        float normalizedResidual = length(flow.xy - initial) / 0.006;
        weight *= 1.0 / (1.0 + normalizedResidual * normalizedResidual);
        fitted += flow.xy * weight;
        fittedWeight += weight;
    }
    if (fittedWeight < 1.0) {
        return vec4(0.0);
    }
    fitted /= fittedWeight;

    float squaredResidual = 0.0;
    float confidenceSum = 0.0;
    float confidenceWeight = 0.0;
    float effectiveSupport = 0.0;
    int inliers = 0;
    for (int index = 0; index < POINT_COUNT; ++index) {
        vec4 flow = inputFlow.vectors[index];
        float spatialWeight = cornerSpatialWeight(index, rightCorner);
        float residual = length(flow.xy - fitted);
        if (baseWeight(flow) > 0.0 && spatialWeight >= 0.08 && residual <= 0.008) {
            squaredResidual += residual * residual * spatialWeight;
            confidenceSum += flow.z * spatialWeight;
            confidenceWeight += spatialWeight;
            effectiveSupport += spatialWeight;
            inliers++;
        }
    }
    float rms = effectiveSupport > 0.0
        ? sqrt(squaredResidual / effectiveSupport)
        : 1.0;
    float confidence = confidenceWeight > 0.0
        ? (confidenceSum / confidenceWeight) * smoothstep(2.5, 6.0, effectiveSupport)
        : 0.0;
    bool valid = inliers >= 4 && effectiveSupport >= 2.5 &&
        confidence >= 0.42 && rms <= 0.008 &&
        length(fitted) <= 0.10;
    return vec4(fitted, confidence, valid ? 1.0 : 0.0);
}
vec4 fitSimilarity(vec4 initial, bool robustPass) {
    float weightSum = 0.0;
    vec2 meanSource = vec2(0.0);
    vec2 meanTarget = vec2(0.0);
    for (int index = 0; index < POINT_COUNT; ++index) {
        vec4 flow = inputFlow.vectors[index];
        vec2 source = pointAt(index);
        vec2 target = source + flow.xy;
        float weight = baseWeight(flow);
        if (robustPass && weight > 0.0) {
            vec2 predicted = vec2(
                initial.x * source.x - initial.y * source.y + initial.z,
                initial.y * source.x + initial.x * source.y + initial.w
            );
            float residual = length(predicted - target);
            float normalized = residual / 0.009;
            weight *= 1.0 / (1.0 + normalized * normalized);
        }
        weightSum += weight;
        meanSource += source * weight;
        meanTarget += target * weight;
    }
    if (weightSum < 1e-5) {
        return vec4(1.0, 0.0, 0.0, 0.0);
    }
    meanSource /= weightSum;
    meanTarget /= weightSum;
    float denominator = 0.0;
    float scaleCosNumerator = 0.0;
    float scaleSinNumerator = 0.0;
    for (int index = 0; index < POINT_COUNT; ++index) {
        vec4 flow = inputFlow.vectors[index];
        vec2 source = pointAt(index);
        vec2 target = source + flow.xy;
        float weight = baseWeight(flow);
        if (robustPass && weight > 0.0) {
            vec2 predicted = vec2(
                initial.x * source.x - initial.y * source.y + initial.z,
                initial.y * source.x + initial.x * source.y + initial.w
            );
            float residual = length(predicted - target);
            float normalized = residual / 0.009;
            weight *= 1.0 / (1.0 + normalized * normalized);
        }
        vec2 centeredSource = source - meanSource;
        vec2 centeredTarget = target - meanTarget;
        denominator += weight * dot(centeredSource, centeredSource);
        scaleCosNumerator += weight * dot(centeredSource, centeredTarget);
        scaleSinNumerator += weight * (
            centeredSource.x * centeredTarget.y - centeredSource.y * centeredTarget.x
        );
    }
    float scaleCos = denominator > 1e-7 ? scaleCosNumerator / denominator : 1.0;
    float scaleSin = denominator > 1e-7 ? scaleSinNumerator / denominator : 0.0;
    float translationX = meanTarget.x - scaleCos * meanSource.x + scaleSin * meanSource.y;
    float translationY = meanTarget.y - scaleSin * meanSource.x - scaleCos * meanSource.y;
    return vec4(scaleCos, scaleSin, translationX, translationY);
}

void main() {
    vec4 initial = fitSimilarity(vec4(1.0, 0.0, 0.0, 0.0), false);
    vec4 fitted = fitSimilarity(initial, true);
    float squaredResidual = 0.0;
    float confidenceSum = 0.0;
    int inliers = 0;
    uint occupiedQuadrants = 0u;
    vec2 minimumInlier = vec2(1.0);
    vec2 maximumInlier = vec2(0.0);
    for (int index = 0; index < POINT_COUNT; ++index) {
        vec4 flow = inputFlow.vectors[index];
        vec2 source = pointAt(index);
        vec2 target = source + flow.xy;
        vec2 predicted = vec2(
            fitted.x * source.x - fitted.y * source.y + fitted.z,
            fitted.y * source.x + fitted.x * source.y + fitted.w
        );
        float residual = length(predicted - target);
        if (baseWeight(flow) > 0.0 && residual <= 0.012) {
            squaredResidual += residual * residual;
            confidenceSum += flow.z;
            inliers++;
            minimumInlier = min(minimumInlier, source);
            maximumInlier = max(maximumInlier, source);
            vec2 roiCenter = (state.roi.xy + state.roi.zw) * 0.5;
            uint quadrant = (source.x >= roiCenter.x ? 1u : 0u) |
                (source.y >= roiCenter.y ? 2u : 0u);
            occupiedQuadrants |= 1u << quadrant;
        }
    }
    float rms = inliers > 0 ? sqrt(squaredResidual / float(inliers)) : 1.0;
    int quadrantCount = bitCount(occupiedQuadrants);
    vec2 roiExtent = max(state.roi.zw - state.roi.xy, vec2(1e-5));
    vec2 relativeInlierSpan = (maximumInlier - minimumInlier) / roiExtent;
    // Textureless skin no longer lowers confidence merely by existing in the ROI. Reliability is
    // instead proven by strong coherent features distributed across the face.
    float countCoverage = clamp(float(inliers) / 28.0, 0.0, 1.0);
    float spatialCoverage = clamp(float(quadrantCount) / 4.0, 0.0, 1.0) *
        smoothstep(0.35, 0.55, relativeInlierSpan.x) *
        smoothstep(0.30, 0.50, relativeInlierSpan.y);
    float confidence = inliers > 0
        ? (confidenceSum / float(inliers)) * sqrt(countCoverage) * spatialCoverage
        : 0.0;
    float scale = length(fitted.xy);
    float rotation = abs(atan(fitted.y, fitted.x));
    float translation = length(fitted.zw);
    // These are per-camera-frame bounds, not smoothing limits. At 30 Hz a deliberate phone
    // jerk can legitimately exceed the old 4.5% translation / 2.9 degree limits. Robust
    // photometric, residual and spatial gates above still have to agree before a wider motion
    // is accepted.
    bool valid = inliers >= 16 && quadrantCount >= 3 &&
        relativeInlierSpan.x >= 0.35 && relativeInlierSpan.y >= 0.30 &&
        confidence >= 0.42 && rms <= 0.012 &&
        scale >= 0.94 && scale <= 1.06 && rotation <= 0.10 && translation <= 0.10;
    outputFit.values[0] = fitted;
    outputFit.values[2] = fitCornerTranslation(false);
    outputFit.values[3] = fitCornerTranslation(true);
    outputFit.values[1] = vec4(confidence, rms, float(inliers), valid ? 1.0 : 0.0);
}
